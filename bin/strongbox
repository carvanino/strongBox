#!/usr/bin/env bash
# =============================================================================
# bin/strongbox — Main entrypoint for the StrongBox server.
#
# Sources all lib modules, registers HTTP handlers, and starts the server.
# =============================================================================

set -uo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB_DIR="$APP_DIR/lib"

# ── Source all modules ────────────────────────────────────────────────────────
for module in storage crypto shamir auth lease dynamic audit consensus http; do
    if [[ -f "$LIB_DIR/${module}.sh" ]]; then
        # shellcheck disable=SC1090
        source "$LIB_DIR/${module}.sh"
    fi
done

# ── Config from environment ───────────────────────────────────────────────────
NODE_ID="${NODE_ID:-node1}"
NODE_ADDR="${NODE_ADDR:-http://127.0.0.1:8200}"
HTTP_PORT="${HTTP_PORT:-8200}"
STORAGE_DIR="${STORAGE_DIR:-/data/secrets}"
CONSENSUS_DIR="${CONSENSUS_DIR:-/data/consensus}"
AUDIT_LOG="${AUDIT_LOG:-/data/audit/audit.log}"
SEALED_FILE="${SEALED_FILE:-/data/sealed}"
SHARES_DIR="${SHARES_DIR:-/data/shares}"
SHAMIR_K="${SHAMIR_K:-2}"
SHAMIR_N="${SHAMIR_N:-3}"

# Postgres env for dynamic.sh
POSTGRES_HOST="${POSTGRES_HOST:-localhost}"
POSTGRES_PORT="${POSTGRES_PORT:-5432}"
POSTGRES_DB="${POSTGRES_DB:-strongbox}"
POSTGRES_USER="${POSTGRES_USER:-strongbox}"
POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-strongbox}"
DYNAMIC_LEASE_TTL="${DYNAMIC_LEASE_TTL:-3600}"

# RAM-backed directory for unseal shares and KEK
RUN_DIR="/dev/shm/strongbox"
if ! mkdir -p "$RUN_DIR" 2>/dev/null; then
    RUN_DIR="/tmp/strongbox-run"
    mkdir -p "$RUN_DIR"
fi

export NODE_ID NODE_ADDR HTTP_PORT STORAGE_DIR CONSENSUS_DIR AUDIT_LOG PEERS
export SEALED_FILE SHAMIR_K SHAMIR_N RUN_DIR
export POSTGRES_HOST POSTGRES_PORT POSTGRES_DB POSTGRES_USER POSTGRES_PASSWORD
export DYNAMIC_LEASE_TTL

# ── Initialise subsystems ─────────────────────────────────────────────────────
mkdir -p "$STORAGE_DIR" "$CONSENSUS_DIR" "$SHARES_DIR" "$(dirname "$AUDIT_LOG")"
storage_init 2>/dev/null || true
audit_init   2>/dev/null || true
dynamic_init 2>/dev/null || true
lease_init   2>/dev/null || true

# Generate AUDIT_HMAC_KEY_HEX if not set — lives in memory only
if [[ -z "${AUDIT_HMAC_KEY_HEX:-}" ]]; then
    export AUDIT_HMAC_KEY_HEX
    AUDIT_HMAC_KEY_HEX=$(openssl rand -hex 32)
fi

# Boot sealed
touch "$SEALED_FILE"
echo "[strongbox] Node $NODE_ID booting sealed on port $HTTP_PORT" >&2

# ── Start the server ──────────────────────────────────────────────────────────
echo "[strongbox] All handlers registered. Starting HTTP server..." >&2
http_serve
