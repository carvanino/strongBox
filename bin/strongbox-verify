#!/usr/bin/env python3
"""Verify StrongBox tamper-evident audit logs."""

from __future__ import annotations

import hashlib
import hmac
import json
import os
import sys
from pathlib import Path


GENESIS_HASH = "0" * 64
HASH_FIELDS_TO_REMOVE = {"entry_hash", "hmac"}


def canonical_payload(entry: dict) -> str:
    payload = {k: v for k, v in entry.items() if k not in HASH_FIELDS_TO_REMOVE}
    return json.dumps(payload, sort_keys=True, separators=(",", ":"))


def summarize(entry: dict) -> str:
    op = entry.get("op", "?")
    path = entry.get("path", "?")
    token_id = entry.get("token_id", "?")
    return f"op={op} path={path} token_id={token_id}"


def tampered(index: int, summary: str) -> int:
    print(f"TAMPERED: entry index {index} — {summary}")
    return 1


def main() -> int:
    if len(sys.argv) < 2:
        print("Usage: strongbox-verify <audit-log-path>", file=sys.stderr)
        return 2

    log_path = Path(sys.argv[1])
    key_hex = os.environ.get("AUDIT_HMAC_KEY_HEX", "")
    if not key_hex:
        key_file = Path(os.environ.get("AUDIT_HMAC_KEY_FILE", log_path.parent / ".audit-hmac-key"))
        if key_file.is_file():
            key_hex = key_file.read_text(encoding="utf-8").strip()
    if not key_hex:
        print("ERROR: AUDIT_HMAC_KEY_HEX or AUDIT_HMAC_KEY_FILE is required", file=sys.stderr)
        return 2

    try:
        key = bytes.fromhex(key_hex)
    except ValueError:
        print("ERROR: AUDIT_HMAC_KEY_HEX must be hex", file=sys.stderr)
        return 2

    if not log_path.is_file():
        print(f"ERROR: Audit log not found at {log_path}", file=sys.stderr)
        return 2

    prev_hash = GENESIS_HASH
    count = 0

    with log_path.open("r", encoding="utf-8") as handle:
        for line in handle:
            if not line.strip():
                continue
            index = count

            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                return tampered(index, "malformed JSON")

            summary = summarize(entry)
            required = {
                "ts",
                "token_id",
                "op",
                "path",
                "version",
                "lease_id",
                "node_id",
                "prev_hash",
                "entry_hash",
                "hmac",
            }
            missing = sorted(required - set(entry))
            if missing:
                return tampered(index, f"{summary} missing={','.join(missing)}")

            if entry.get("prev_hash") != prev_hash:
                return tampered(index, f"{summary} prev_hash mismatch")

            computed_hash = hashlib.sha256(canonical_payload(entry).encode("utf-8")).hexdigest()
            if not hmac.compare_digest(str(entry.get("entry_hash", "")), computed_hash):
                return tampered(index, f"{summary} entry_hash mismatch")

            computed_hmac = hmac.new(key, computed_hash.encode("ascii"), hashlib.sha256).hexdigest()
            if not hmac.compare_digest(str(entry.get("hmac", "")), computed_hmac):
                return tampered(index, f"{summary} hmac mismatch")

            prev_hash = computed_hash
            count += 1

    print(f"OK: entries={count} final_hash={prev_hash}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
